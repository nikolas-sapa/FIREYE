%%{init: {"theme":"base","fontFamily":"Geist Sans","fontSize":18,"themeVariables":{"background":"#ffffff","primaryColor":"#fafafa","primaryTextColor":"#171717","primaryBorderColor":"#8f8f8f","lineColor":"#4d4d4d","secondaryColor":"#ffffff","tertiaryColor":"#fafafa","clusterBkg":"#fafafa","clusterBorder":"#c9c9c9","edgeLabelBackground":"#ffffff"},"flowchart":{"htmlLabels":false,"curve":"linear","nodeSpacing":32,"rankSpacing":48,"padding":20}}}%%
graph TD
  accTitle: Fire Command Center system overview, current local core and planned integrations
  accDescr: Solid blue nodes are implemented pure local TypeScript. Dashed gray nodes are planned integrations. Evidence adapters and analyst models are not connected. Convex is the approved eventual shared authority, not provisioned. A separate teammate prototype is unmerged. Human decisions and received simulator facts must pass the local protocol boundary.

  subgraph INPUTS["PLANNED inputs"]
    direction TB
    DATA["News · satellite · cameras<br/>Weather · terrain"]
    ANALYSIS["Source adapters + analysts<br/>Unverified evidence / proposals"]
    DATA --> ANALYSIS
  end

  subgraph CORE["BUILT local core"]
    direction TB
    VALIDATE["Validate envelopes<br/>Run · actor · revision · clocks"]
    STATE["Received-event state<br/>Immutable reducer + history"]
    GATE["Chief approval gate<br/>Finite scope + reservation"]
    REPLAY["Deterministic replay<br/>Received facts only"]
    VALIDATE --> STATE
    STATE --> GATE
    STATE --> REPLAY
  end

  subgraph APPLICATION["PLANNED app integration"]
    direction TB
    CONVEX["Convex canonical authority<br/>Approved direction, not provisioned"]
    UI["Crew Map + Camera Room<br/>Teammate UI prototype unmerged"]
    SIM["Single simulator producer<br/>Deterministic drone executors"]
    CONVEX --> UI
    CONVEX --> SIM
  end

  ANALYSIS -. received evidence .-> VALIDATE
  UI -. current Chief decision .-> GATE
  GATE -. enqueued simulation command .-> CONVEX
  SIM -. actual received facts .-> VALIDATE

  classDef built fill:#ffffff,stroke:#006bff,stroke-width:2px,color:#171717;
  classDef planned fill:#fafafa,stroke:#7d7d7d,stroke-width:1.5px,stroke-dasharray:6 4,color:#171717;
  class VALIDATE,STATE,GATE,REPLAY built;
  class DATA,ANALYSIS,CONVEX,UI,SIM planned;
  style INPUTS fill:#ffffff,stroke:#c9c9c9,stroke-dasharray:6 4
  style CORE fill:#fafafa,stroke:#006bff
  style APPLICATION fill:#ffffff,stroke:#c9c9c9,stroke-dasharray:6 4
