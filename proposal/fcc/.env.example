# Copy to .env.local (gitignored) and fill in. Every key is optional; the console falls back gracefully.
# Cesium ion Community token (https://ion.cesium.com/tokens) — world terrain + imagery.
VITE_CESIUM_ION_TOKEN=
# Google Maps Platform key with Map Tiles API enabled (billing required) — Photorealistic 3D Tiles.
VITE_GOOGLE_MAPS_KEY=
# NASA FIRMS map key (https://firms.modaps.eosdis.nasa.gov/api/map_key/) — used only by scripts/fetch-data.mjs.
FIRMS_MAP_KEY=
